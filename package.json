{
  "name": "@latchway/docs",
  "version": "0.0.0-private",
  "private": true,
  "description": "Mintlify documentation for Latchway",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "@mintlify/scraping>puppeteer": "25.5.0",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "dev": "mint dev --no-open",
    "validate": "mint validate",
    "check:generated": "python3 scripts/check-generated.py && python3 scripts/check-sdk-bundles.py",
    "check:structure": "python3 scripts/check-structure.py",
    "check:metadata": "python3 scripts/check_metadata.py && python3 -m unittest scripts/test_check_metadata.py",
    "check:prose": "vale --minAlertLevel=error .",
    "check:links": "mint broken-links --check-anchors --check-redirects --check-snippets",
    "check:a11y": "mint a11y",
    "check": "pnpm check:generated && pnpm check:structure && pnpm check:metadata && pnpm check:prose && pnpm validate && pnpm check:links && pnpm check:a11y"
  },
  "devDependencies": {
    "mdx2vast": "0.5.0",
    "mint": "4.2.850"
  }
}
